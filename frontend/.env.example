# Copy this file to .env and fill in your values
# .env is gitignored — never commit secrets

# PostgreSQL
POSTGRES_PASSWORD=changeme

# Keycloak admin (must match KEYCLOAK_ADMIN_PASSWORD in docker-compose)
KC_ADMIN_PASSWORD=changeme

# CORS – comma-separated list of allowed origins for the Spring backend
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost
